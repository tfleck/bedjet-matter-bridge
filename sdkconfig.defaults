# ==============================================================================
# Common defaults, shared by every transport.
#
# The transport-specific block lives in sdkconfig.defaults.thread or
# sdkconfig.defaults.wifi, selected by the MATTER_TRANSPORT CMake option
# (CMakeLists.txt). Default transport is 'thread'.
#
# CONFIG_IDF_TARGET is intentionally NOT pinned here so the same tree can be
# built for ESP32-C6 (Thread or Wi-Fi) and the Wi-Fi-only ESP32 / ESP32-C3 /
# ESP32-S3. Run `idf.py set-target <board>` before configuring (CI does).
# ==============================================================================

# ==============================================================================
# 1. System, FreeRTOS & Stability Tweaks
# ==============================================================================
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=5120

# Optimise for size instead of the IDF default -Og (CONFIG_COMPILER_OPTIMIZATION_DEBUG).
# On a 4 MB part the two OTA slots are pinned at 0x1F0000 and the image was left
# with only ~3% free; -Os reclaims a large fraction of the Matter/CHIP code and is
# the only lever that widens real headroom there. See QA-REVIEW-PLAN.md B1.1-B1.2.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ==============================================================================
# 2. Hardware Flash & Partition Configuration
# ==============================================================================
# Custom layout with two equal OTA slots - see partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Both slots in partitions.csv are sized for this flash size.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Most standard ESP32-C6 dev kits require DIO mode.
# Changed from QIO to prevent fatal "boot loader header corrupt" loop crashes.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ==============================================================================
# 3. Networking, Encryption & Crypto Core
# ==============================================================================
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# ==============================================================================
# 4. Bluetooth Core & NimBLE Optimization (both transports)
# ==============================================================================
# CHIPoBLE commissions the node (PASE) and, for Wi-Fi builds, carries the Wi-Fi
# credentials; the BedJet central also uses this one NimBLE stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# Time-share the single radio: Matter owns NimBLE during commissioning, then the
# app shuts Matter BLE down (without memory release) so the BedJet central can
# init fresh. USE_BLE_ONLY_FOR_COMMISSIONING must stay OFF: when on, Matter calls
# esp_bt_mem_release() which permanently frees the BLE BSS/data to the heap and
# BedJet nimble_port_init() can never succeed again. Handover is driven from
# main.cpp (Shutdown + retry, not kBLEDeinitialized - that event only fires on
# the mem-release path).
# CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# Kept at 3 deliberately: the NimBLE connection limit is shared between this
# bridge's single BedJet client and Matter's CHIPoBLE commissioner. Dropping it
# to 1 would save ~1.5 KB RAM but risks refusing the commissioner's connection
# while the BedJet link is up.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL must stay at its default (y) even though this
# bridge only ever acts as a central. ESP-IDF's NimBLE GAP/GATT services and the
# ATT server are compiled out without it, and esp-matter's CHIP BLE layer then
# fails to link with undefined ble_svc_gap_init / ble_svc_gatt_init /
# ble_att_svr_read_handle.
#
# esp-nimble-cpp runs std::function GATT callbacks and service discovery on the
# NimBLE host task. The C default of 4096 is not enough headroom for that.
# NOTE: idf.py renames this key to CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE in the
# generated sdkconfig; keep this spelling (the old name) - the renamed key in
# sdkconfig.defaults would be dropped as unknown and the 4K default restored.
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=6144

# ==============================================================================
# 5. Matter data model
# ==============================================================================
# VendorName/ProductName shown in Home come from the CHIP
# DeviceInstanceInfoProvider. Those macros default to "TEST_VENDOR" /
# "TEST_PRODUCT" with no Kconfig knobs, so they are overridden globally in the
# top-level CMakeLists.txt via add_compile_definitions (a per-target define on
# main would miss the provider, which compiles inside esp-matter).
# NOTE: CONFIG_ESP_MATTER_AGGREGATOR_ENDPOINT_COUNT is intentionally left alone.
# Its Kconfig range is "1 5", so setting 0 is rejected and clamped back with a
# kconfgen warning. It also never creates an aggregator endpoint: the only
# consumer in esp-matter 1.6.0 is the MAX_BRIDGED_DEVICE_COUNT arithmetic in
# esp_matter_bridge.h. This node is a plain composed node, not a bridged one.
