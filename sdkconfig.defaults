# ==============================================================================
# 0. Target
# ==============================================================================
# sdkconfig is gitignored, so without this a fresh clone falls back to the ESP32
# default and the Thread / 802.15.4 build fails. ESP-IDF reads this while
# selecting the toolchain.
CONFIG_IDF_TARGET="esp32c6"

# ==============================================================================
# 1. System, FreeRTOS & Stability Tweaks
# ==============================================================================
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=5120

# Optimise for size instead of the IDF default -Og (CONFIG_COMPILER_OPTIMIZATION_DEBUG).
# On a 4 MB part the two OTA slots are pinned at 0x1F0000 and the image was left
# with only ~3% free; -Os reclaims a large fraction of the Matter/CHIP code and is
# the only lever that widens real headroom there. See QA-REVIEW-PLAN.md B1.1-B1.2.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ==============================================================================
# 2. Hardware Flash & Partition Configuration
# ==============================================================================
# Custom layout with two equal OTA slots - see partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Both slots in partitions.csv are sized for this flash size.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Most standard ESP32-C6 dev kits require DIO mode.
# Changed from QIO to prevent fatal "boot loader header corrupt" loop crashes.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ==============================================================================
# 3. Networking, Encryption & Crypto Core
# ==============================================================================
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# ==============================================================================
# 4. Bluetooth Core & NimBLE Optimization
# ==============================================================================
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# Time-share the single C6 BLE controller: Matter owns NimBLE during
# commissioning (CHIPoBLE for PASE + Thread dataset delivery), then the app
# shuts Matter BLE down (without memory release) so the BedJet central can
# init fresh. USE_BLE_ONLY_FOR_COMMISSIONING must stay OFF: when on, Matter
# calls esp_bt_mem_release() which permanently frees the BLE BSS/data to the
# heap and BedJet nimble_port_init() can never succeed again. Handover is
# driven from main.cpp (Shutdown + retry, not kBLEDeinitialized - that event
# only fires on the mem-release path).
# CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# Kept at 3 deliberately: the NimBLE connection limit is shared between this
# bridge's single BedJet client and Matter's CHIPoBLE commissioner. Dropping
# it to 1 would save ~1.5 KB RAM but risks refusing the commissioner's
# connection while the BedJet link is up. The bridge only ever creates one
# client object and reuses it, so slot exhaustion cannot happen at 3.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL must stay at its default (y) even though this
# bridge only ever acts as a central. ESP-IDF's NimBLE GAP/GATT services and the
# ATT server are compiled out without it, and esp-matter's CHIP BLE layer then
# fails to link with undefined ble_svc_gap_init / ble_svc_gatt_init /
# ble_att_svr_read_handle.

# esp-nimble-cpp runs std::function GATT callbacks and service discovery on the
# NimBLE host task. The C default of 4096 is not enough headroom for that.
# NOTE: idf.py renames this key to CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE in the
# generated sdkconfig; keep this spelling (the old name) - the renamed key in
# sdkconfig.defaults would be dropped as unknown and the 4K default restored.
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=6144

# ==============================================================================
# 5. Native OpenThread & 802.15.4 Radio Config
# ==============================================================================
# Turn on the physical IEEE 802.15.4 radio link layer
CONFIG_IEEE802154_ENABLED=y

# Enable OpenThread Core Stack Engine
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y

# Configure as a Minimal Thread Device (MTD): this bridge is a BLE central
# with the radio already shared, so it must not route for Apple's mesh. MTD
# halves MLE chatter and duty cycle vs FTD. Only switch back to FTD if the
# BedJet sits far from the Apple TV and needs this node as a mesh extender.
# NOTE: this is a Kconfig choice with default FTD - the explicit unset line is
# required or kconfgen keeps the old selection.
CONFIG_OPENTHREAD_FTD=n
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y

# LwIP IPv6 optimizations specifically mapped for Thread routing payloads
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y

# ==============================================================================
# 6. Wi-Fi
# ==============================================================================
# ESP32-C6 has a combo Wi-Fi + BLE + 802.15.4 radio (SOC_PHY_COMBO_MODULE), so
# NimBLE and Thread coexist natively. Wi-Fi and 802.15.4 cannot be used at the
# same time, so Wi-Fi is compiled but permanently off.
#
# There is deliberately NO esp_coex configuration here. components/esp_coex
# arbitrates Wi-Fi against Bluetooth only - it has no knowledge of 802.15.4, and
# enabling it only serves to force-disable OpenThread diagnostics. The earlier
# CONFIG_ESP_COEX_SW_COEXIST_ENABLE / CONFIG_EXTERNAL_COEX_ENABLE settings were
# removed for that reason; CONFIG_OPENTHREAD_COEXIST_ENABLE never existed in
# ESP-IDF and was being silently dropped.
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_WIFI_STATION=n

# ==============================================================================
# 7. Matter data model
# ==============================================================================
# VendorName/ProductName shown in Home come from the CHIP
# DeviceInstanceInfoProvider. Those macros default to "TEST_VENDOR" /
# "TEST_PRODUCT" with no Kconfig knobs, so they are overridden globally in the
# top-level CMakeLists.txt via add_compile_definitions (a per-target define on
# main would miss the provider, which compiles inside esp-matter).
# NOTE: CONFIG_ESP_MATTER_AGGREGATOR_ENDPOINT_COUNT is intentionally left alone.
# Its Kconfig range is "1 5", so setting 0 is rejected and clamped back with a
# kconfgen warning. It also never creates an aggregator endpoint: this esp-matter
# release has no consumer for it (the old esp_matter_bridge.h is gone). The node
# is made a bridge at runtime instead, by adding the Aggregator device type to
# endpoint 0 and the Bridged Node device type to each child endpoint in
# bedjet_matter.cpp.
